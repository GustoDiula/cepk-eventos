{
  "name": "cepk-eventos",
  "version": "0.1.0",
  "private": true,
  "description": "PWA para centralizar os eventos do Colégio Estadual Presidente Kennedy (CEPK)",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/backend/server.js",
    "start": "node --env-file-if-exists=.env src/backend/server.js",
    "test": "node --env-file-if-exists=.env --test \"tests/**/*.test.mjs\"",
    "db:aplicar": "node --env-file-if-exists=.env src/backend/db/seed-demo.js --schema-only",
    "db:demonstracao": "node --env-file-if-exists=.env src/backend/db/seed-demo.js",
    "pg:start": "powershell -ExecutionPolicy Bypass -File scripts/pgsql-start.ps1",
    "pg:stop": "powershell -ExecutionPolicy Bypass -File scripts/pgsql-stop.ps1",
    "demo:gerar": "node scripts/gerar-demo.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  }
}
