# Modelo de variáveis de ambiente — NUNCA colocar valores reais aqui (RNF05/regra 6).
# Copie para .env (fora do Git) e preencha com valores reais em segredo.

# ambiente: development | test | production
NODE_ENV=development

# conexão com PostgreSQL local (obrigatória em production).
# Formato: postgresql://USUARIO:SENHA@127.0.0.1:5432/cepk_eventos
DATABASE_URL=

# assinatura do cookie de sessão (obrigatória em production; gerar valor aleatório
# longo — ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# duração da sessão em minutos (padrão 480 = 8 horas)
SESSION_MAX_MINUTOS=480

# senha inicial ÚNICA das contas de demonstração (usada só pelo seed para gerar o
# hash bcrypt; a senha jamais fica no repositório — só o hash vai para o banco)
SENHA_DEMO=

# endereço público do sistema (P-2 define o valor final)
BASE_URL=http://localhost:3000

# porta local (opcional; padrão 3000)
PORT=3000
