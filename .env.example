# Modelo de variáveis de ambiente — NUNCA colocar valores reais aqui (RNF05/regra 6).
# Copie para .env (fora do Git) e preencha com valores reais em segredo.

# ambiente: development | test | production
NODE_ENV=development

# conexão com PostgreSQL (obrigatória em production; dispensada até a etapa 2)
DATABASE_URL=

# assinatura do cookie de sessão (obrigatória em production; gerar valor aleatório)
SESSION_SECRET=

# endereço público do sistema (P-2 define o valor final)
BASE_URL=http://localhost:3000

# porta local (opcional; padrão 3000)
PORT=3000
